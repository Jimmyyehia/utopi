# ==============================================================================
# UTOPI WORKSPACE PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Turso 24/7 Free Serverless LibSQL or Local SQLite)
# ------------------------------------------------------------------------------
# For 24/7 Free Cloud Hosting with Turso:
# 1. Create free account at https://turso.tech
# 2. Run: turso db create utopi-prod
# 3. Run: turso db tokens create utopi-prod
DATABASE_URL="libsql://utopi-prod-[your-org].turso.io"
DATABASE_AUTH_TOKEN="your-turso-jwt-auth-token"

# For Local Development or Docker Standalone SQLite (comment above out):
# DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 32-byte secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-character-random-secret-key-here"
# In production, set to your live custom domain (e.g. https://utopi.space or https://utopi.vercel.app)
NEXTAUTH_URL="https://utopi.space"

# Optional Initial Admin Setup Password
INITIAL_ADMIN_PASSWORD="YourSecureAdminPassword2026!"

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL DISPATCHER (Resend 24/7 Free Tier: 3,000 emails/mo)
# ------------------------------------------------------------------------------
# Get your free API key at https://resend.com
RESEND_API_KEY="re_123456789_abcdefg"

# ------------------------------------------------------------------------------
# 4. OPTIONAL OAUTH PROVIDERS (Google / GitHub)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 5. WEBSOCKET REALTIME (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SOCKET_URL=""
